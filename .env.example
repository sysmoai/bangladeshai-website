# BangladeshAI - Environment Configuration

# General
NODE_ENV=development
SITE_URL=https://bangladeshai.org
SITE_TITLE=BangladeshAI - National AI Readiness Assessment

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bangladeshai_db

# API Configuration
API_PORT=3000
API_HOST=localhost
API_BASE_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_key
SESSION_SECRET=your_session_secret

# Email Service
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_key

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# Research Data
DATA_EXPORT_FORMAT=json
REPORT_GENERATION_ENABLED=true

# Contact
CONTACT_EMAIL=contact@bangladeshai.org
ADMIN_EMAIL=admin@bangladeshai.org
